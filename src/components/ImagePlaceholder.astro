---
interface Props {
  aspect?: string;
  label?: string;
  recommended?: string;
  rounded?: string;
  class?: string;
}

const {
  aspect = "aspect-[4/3]",
  label = "Espacio para fotografía",
  recommended = "Reemplazar con tu imagen",
  rounded = "rounded-2xl",
  class: className = "",
} = Astro.props;
---

<div
  class={`relative overflow-hidden bg-celeste-light/30 border-2 border-dashed border-sombra/80 flex flex-col items-center justify-center p-6 text-center group hover:border-celeste transition-all duration-300 ${aspect} ${rounded} ${className}`}
>
  <!-- Background subtle pattern -->
  <div class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#1A2B3C_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="relative z-10 flex flex-col items-center gap-3">
    <!-- Camera/Photo Icon -->
    <div class="w-12 h-12 rounded-full bg-crema/90 border border-sombra/50 flex items-center justify-center text-espresso/70 group-hover:scale-105 group-hover:text-celeste-dark transition-all duration-300 shadow-xs">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
    </div>

    <!-- Label -->
    <div class="space-y-1">
      <p class="text-xs md:text-sm font-semibold text-espresso">
        {label}
      </p>
      <p class="text-[11px] text-espresso/60 font-medium">
        {recommended}
      </p>
    </div>

    <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-crema text-celeste-dark border border-sombra/30 mt-1">
      Espacio para imagen
    </span>
  </div>
</div>
