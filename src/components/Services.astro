---
import { Image } from "astro:assets";
import charlasImg from "../assets/images/CHARLAS.jpeg";
import talleresImg from "../assets/images/FullSizeRender (1).jpeg";
import terapiaImg from "../assets/images/TERAPIA INDIVIDUAL.jpeg";

// Fotos intercambiadas según pedido:
// Charlas ahora lleva talleresImg (FullSizeRender 1) y Talleres lleva charlasImg (CHARLAS)
const services = [
  {
    number: "01",
    title: "Charlas de Desarrollo Humano",
    duration: "60–90 min · Presencial / Virtual",
    image: talleresImg,
    imageAlt: "Charla vivencial de desarrollo humano facilitada por Jen Obando",
    description:
      "Encuentros inspiradores y reflexivos donde exploramos el cuerpo como primer lenguaje, el maternaje consciente y el paso transformador de sobrevivir a elegir la propia vida.",
    points: [
      "El cuerpo: nuestro primer territorio",
      "Maternar sin perder la propia identidad",
      "Formatos para empresas, colectivos y comunidades",
    ],
    ctaText: "Solicitar información",
    ctaLink: "#contacto",
  },
  {
    number: "02",
    title: "Talleres Terapéuticos",
    duration: "3 horas · Grupos íntimos de 6 a 10 personas",
    image: charlasImg,
    imageAlt: "Taller terapéutico vivencial en grupo guiado por Jen Obando",
    description:
      "Laboratorios vivenciales de movimiento somático, respiración conectada, meditación y reprogramación de patrones automáticos en un círculo seguro y contenido.",
    points: [
      "Movimiento somático y anclaje al presente",
      "Liberación de tensiones psicosomáticas",
      "Rituales de integración para la vida cotidiana",
    ],
    ctaText: "Ver próximas fechas",
    ctaLink: "#contacto",
  },
  {
    number: "03",
    title: "Terapia Individual",
    duration: "60–75 min · Presencial o Virtual",
    image: terapiaImg,
    imageAlt: "Sesión de terapia individual cálida con Jen Obando en Quito",
    description:
      "Acompañamiento 1 a 1 bajo el enfoque Gestalt Integrativo. Un refugio confidencial para sentirte vista, escuchada y comprendida en tu ritmo y sin juicios.",
    points: [
      "Sesiones personalizadas a tu necesidad",
      "Modalidad presencial en Quito u online",
      "Integración de cuerpo, emoción y pensamiento",
    ],
    ctaText: "Agendar una consulta",
    ctaLink: "#contacto",
  },
];
---

<section id="servicios" class="pt-28 md:pt-36 pb-32 md:pb-40 bg-forest text-ivory relative overflow-hidden">
  <!-- Borde superior ondulado curvo desde la sección clara de Sobre Mí -->
  <div class="absolute top-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none -translate-y-[1px]">
    <svg
      class="relative block w-full h-8 sm:h-12 md:h-16 lg:h-20"
      viewBox="0 0 1440 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        d="M0 0V45C220 85 440 15 660 40C880 65 1100 25 1280 50C1360 60 1400 55 1440 45V0H0Z"
        class="fill-cream"
      />
    </svg>
  </div>

  <!-- Acentos luminosos orgánicos sobre el fondo verde bosque -->
  <div class="absolute top-1/4 -right-32 w-96 h-96 rounded-full bg-moss/50 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 -left-32 w-96 h-96 rounded-full bg-deep-moss/70 blur-3xl pointer-events-none"></div>

  <div class="max-w-[1360px] mx-auto px-6 lg:px-12 relative z-10">
    
    <!-- Encabezado de Sección -->
    <div class="max-w-2xl mx-auto text-center mb-16 md:mb-20">
      <span class="text-xs uppercase tracking-[0.24em] font-sans font-semibold text-gold block mb-3">
        ESPACIOS DE ACOMPAÑAMIENTO
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-ivory font-normal leading-[1.12] mb-5">
        Caminos para tu bienestar
      </h2>
      <p class="font-sans text-ivory/80 text-base md:text-lg leading-relaxed max-w-xl mx-auto">
        Diferentes espacios diseñados para acompañarte en tu proceso personal, desde la resonancia compartida en comunidad hasta la intimidad de la terapia individual.
      </p>
    </div>

    <!-- Grid de 3 Columnas de Servicios con bordes curvos y tarjetas en Ivory -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {services.map((item) => (
        <article class="bg-ivory text-charcoal rounded-[28px] border border-gold/30 overflow-hidden flex flex-col justify-between shadow-2xl hover:border-gold/60 transition-all duration-300 group">
          <div>
            <!-- Cabecera de Imagen con Arco Orgánico Inferior -->
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-cream">
              <Image
                src={item.image}
                alt={item.imageAlt}
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                width={800}
                height={500}
                quality={90}
              />
              <div class="absolute inset-0 bg-forest/10 group-hover:bg-transparent transition-colors duration-300"></div>
              
              <!-- Badge de Número Flotante -->
              <div class="absolute top-4 left-4 bg-ivory/95 backdrop-blur-xs font-serif text-base text-forest font-medium px-3.5 py-1 rounded-full border border-gold/40 shadow-xs">
                {item.number}
              </div>
            </div>

            <!-- Contenido de la Tarjeta -->
            <div class="p-7 sm:p-8">
              <span class="text-xs font-sans text-muted font-medium block mb-2">
                {item.duration}
              </span>
              <h3 class="font-serif text-2xl lg:text-[26px] text-forest font-medium leading-snug mb-3">
                {item.title}
              </h3>
              <p class="font-sans text-charcoal/80 text-sm leading-relaxed mb-6">
                {item.description}
              </p>

              <!-- Lista de Puntos Clave -->
              <ul class="space-y-2.5 border-t border-charcoal/8 pt-5">
                {item.points.map((pt) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-[13px] text-charcoal/85">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold mt-1.5 flex-shrink-0"></span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Botón de Acción Alineado Inferior con Borde Curvo Orgánico -->
          <div class="px-7 pb-8 pt-2">
            <a
              href={item.ctaLink}
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-earth text-ivory text-xs sm:text-sm font-sans font-medium uppercase tracking-wider hover:bg-forest hover:text-white transition-all duration-300 shadow-xs group-hover:shadow-md"
            >
              <span>{item.ctaText}</span>
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <!-- Borde inferior ondulado hacia la sección clara de Contacto -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none translate-y-[1px]">
    <svg
      class="relative block w-full h-8 sm:h-12 md:h-16 lg:h-20"
      viewBox="0 0 1440 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        d="M0 45C240 85 480 15 720 50C960 85 1200 20 1440 60V100H0V45Z"
        class="fill-cream"
      />
    </svg>
  </div>
</section>
