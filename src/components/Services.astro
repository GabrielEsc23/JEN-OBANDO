---
import { Image } from "astro:assets";
import charlasImg from "../assets/images/CHARLAS.jpeg";
import talleresImg from "../assets/images/FullSizeRender (1).jpeg";
import terapiaImg from "../assets/images/TERAPIA INDIVIDUAL.jpeg";

const services = [
  {
    title: "Charlas de Desarrollo Humano",
    format: "60–90 min · Presencial + Streaming",
    image: charlasImg,
    imageAlt: "Charla vivencial de desarrollo humano con Jen Obando",
    description:
      "Encuentros vivenciales sobre el cuerpo como primer lenguaje, maternaje consciente y el paso de sobrevivir a elegir propia vida.",
    featuresTitle: "Temáticas habituales:",
    features: [
      "El cuerpo: el primer lenguaje",
      "Maternar sin perderte a ti misma",
      "De sobrevivir a elegir propia vida",
      "Formatos para empresas y comunidades",
    ],
    ctaText: "Solicitar información para charla",
    ctaLink: "#contacto",
    highlight: false,
  },
  {
    title: "Talleres Terapéuticos",
    format: "3 horas · Grupos de 6 a 10 personas",
    image: talleresImg,
    imageAlt: "Taller terapéutico grupal en entorno cuidado con Jen Obando",
    description:
      "Movimiento somático, respiración, meditación, reprogramación de patrones automáticos y rituales de autoobservación.",
    featuresTitle: "La vivencia incluye:",
    features: [
      "Respiración y movimiento somático guiado",
      "Meditación y anclaje al aquí y ahora",
      "Reprogramación de patrones automáticos",
      "Rituales y autoobservación para la vida diaria",
    ],
    ctaText: "Ver próximas fechas",
    ctaLink: "#contacto",
    highlight: true,
  },
  {
    title: "Terapia Individual",
    format: "60–75 min · Presencial / Virtual",
    image: terapiaImg,
    imageAlt: "Espacio de terapia individual cálido e íntimo con Jen Obando",
    description:
      "Enfoque Gestalt Integrativo. Un lugar seguro para sentirte vista, escuchada y aceptada a tu propio ritmo.",
    featuresTitle: "Detalles del proceso:",
    features: [
      "Sesiones personalizadas de 60–75 minutos",
      "Modalidad presencial u online",
      "Acompañamiento en el aquí y el ahora",
      "Espacio íntimo, confidencial y sin juicios",
    ],
    ctaText: "Agendar una consulta",
    ctaLink: "#contacto",
    highlight: false,
  },
];
---

<section id="servicios" class="py-20 md:py-28 bg-salvia-light/50 border-y border-salvia/20 relative overflow-hidden">
  <!-- Acentos orgánicos ambientales -->
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-salvia/20 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-celeste-light/40 blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-espresso mb-4">
        Espacios de acompañamiento
      </h2>
      <p class="text-espresso/75 text-base md:text-lg leading-relaxed">
        Modalidades vivenciales diseñadas para distintos momentos: desde la inspiración compartida en charlas hasta la intimidad transformadora de la terapia 1 a 1.
      </p>
    </div>

    <!-- Grid de Servicios / Productos con imágenes reales optimizadas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {services.map((service) => (
        <div
          class={`rounded-2xl p-6 md:p-7 flex flex-col justify-between transition-all duration-300 relative group ${
            service.highlight
              ? "bg-crema border-2 border-celeste shadow-xl ring-4 ring-celeste/15"
              : "bg-crema border border-sombra/60 hover:border-salvia shadow-xs hover:shadow-md"
          }`}
        >
          <div>
            <!-- Fotografía del servicio optimizada con Astro Assets -->
            <div class="mb-6 relative overflow-hidden rounded-xl aspect-[16/10] border border-sombra/40 bg-salvia-light/25 shadow-xs">
              <Image
                src={service.image}
                alt={service.imageAlt}
                class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-500 ease-out"
              />
            </div>

            <!-- Título y formato -->
            <h3 class="text-xl md:text-2xl font-bold text-espresso mb-1">
              {service.title}
            </h3>
            <p class="text-xs font-semibold text-salvia-dark tracking-wide mb-4">
              {service.format}
            </p>

            <!-- Descripción Lorem Ipsum -->
            <p class="text-espresso/75 text-sm leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- Bullets -->
            <div class="pt-4 border-t border-sombra/25">
              <p class="text-xs font-semibold uppercase tracking-wider text-espresso/80 mb-3">
                {service.featuresTitle}
              </p>
              <ul class="space-y-2">
                {service.features.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs md:text-sm text-espresso/80">
                    <span class="w-1.5 h-1.5 rounded-full bg-salvia mt-1.5 flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Botón CTA -->
          <div class="mt-8 pt-5 border-t border-sombra/20">
            <a
              href={service.ctaLink}
              class={`w-full block text-center py-3 px-6 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-200 ${
                service.highlight
                  ? "bg-espresso text-crema hover:bg-celeste-dark shadow-sm"
                  : "bg-crema text-espresso border border-sombra/70 hover:border-celeste hover:text-celeste-dark hover:bg-celeste-light/30"
              }`}
            >
              {service.ctaText}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
