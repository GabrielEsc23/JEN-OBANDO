---
import selvaSvg from "../assets/images/selva.svg";

const pillars = [
  {
    number: "01",
    title: "Consciencia Corporal",
    icon: "body",
    description:
      "El cuerpo nunca miente. La ansiedad aprieta el pecho y el cansancio se guarda en los hombros. Escuchar al cuerpo es el primer paso hacia la sanación real.",
  },
  {
    number: "02",
    title: "Presencia Plena",
    icon: "lotus",
    description:
      "La vida real solo ocurre en este instante. La transformación sucede cuando aprendes a hacer una pausa y estar presente con todo lo que eres hoy.",
  },
  {
    number: "03",
    title: "Coherencia Integrativa",
    icon: "venn",
    description:
      "Sanas de verdad cuando lo que piensas, lo que sientes y lo que haces caminan hacia el mismo lugar. No es solo entenderlo en la cabeza, sino sentirlo con calma y actuar con claridad.",
  },
];
---

<section id="pilares" class="pt-20 md:pt-28 pb-28 md:pb-36 lg:pb-40 bg-forest text-ivory relative overflow-hidden">
  <!-- Fondo ilustrado de selva.svg con opacidad transparente y efecto borroso -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
    <img
      src={selvaSvg.src}
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-center opacity-25 filter blur-[3px] scale-105"
      loading="lazy"
      decoding="async"
    />
    <!-- Capas de tinte verde bosque para armonizar y asegurar legibilidad -->
    <div class="absolute inset-0 bg-forest/50 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-forest/80 via-transparent to-forest/90"></div>
  </div>

  <!-- Sombra ambiental muy sutil en las esquinas -->
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-moss/60 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-moss/60 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <!-- Encabezado de la sección centrado -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20 reveal-on-scroll" data-animate="animate__fadeInUp">
      <span class="text-[11px] sm:text-xs font-semibold tracking-[0.24em] uppercase text-gold inline-block mb-3">
        MI ENFOQUE
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[46px] font-normal text-ivory tracking-tight leading-tight">
        Tres pilares para una transformación real
      </h2>
    </div>

    <!-- Grid de 3 Pilares con separadores verticales finos en dorado -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-0">
      {pillars.map((pilar, index) => (
        <div
          class="md:px-8 lg:px-10 flex flex-col items-center md:items-start text-center md:text-left relative md:border-r border-gold/25 last:border-r-0 reveal-on-scroll"
          data-animate="animate__fadeInUp"
          data-delay={`${index * 150 + 100}ms`}
        >
          
          <!-- Fila superior: Número + Icono lineal dorado -->
          <div class="flex items-center gap-4 mb-6">
            <span class="font-serif text-xl sm:text-2xl text-gold font-normal">
              {pilar.number}
            </span>

            <div class="w-14 h-14 rounded-full border border-gold/40 flex items-center justify-center text-gold/90 bg-forest/80 shadow-xs">
              {pilar.icon === "body" && (
                <!-- Icono de torso / consciencia corporal -->
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <circle cx="12" cy="6" r="3.2"></circle>
                  <path d="M7 21v-4a5 5 0 0 1 10 0v4"></path>
                  <path d="M12 11v4"></path>
                  <path d="M10 13h4"></path>
                </svg>
              )}

              {pilar.icon === "lotus" && (
                <!-- Icono flor de loto / presencia plena -->
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M12 4c1 4 4 7 8 8-4 1-6 4-6 8-2-3-4-5-4-8 0-3 1-5 2-8z"></path>
                  <path d="M12 4c-1 4-4 7-8 8 4 1 6 4 6 8 2-3 4-5 4-8 0-3-1-5-2-8z"></path>
                  <circle cx="12" cy="14" r="2"></circle>
                </svg>
              )}

              {pilar.icon === "venn" && (
                <!-- Icono círculos de coherencia integrativa -->
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <circle cx="9" cy="10" r="4.5"></circle>
                  <circle cx="15" cy="10" r="4.5"></circle>
                  <circle cx="12" cy="15" r="4.5"></circle>
                </svg>
              )}
            </div>
          </div>

          <!-- Título del Pilar -->
          <h3 class="font-serif text-2xl sm:text-[26px] font-normal text-ivory mb-3 leading-snug">
            {pilar.title}
          </h3>

          <!-- Descripción del Pilar -->
          <p class="text-ivory/80 text-sm sm:text-base leading-relaxed font-normal">
            {pilar.description}
          </p>

        </div>
      ))}
    </div>
  </div>

  <!-- Borde inferior ondulado hacia la sección de Herramientas -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none translate-y-[1px]">
    <svg
      class="relative block w-full h-10 sm:h-14 md:h-20 lg:h-24"
      viewBox="0 0 1440 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        d="M0 35C320 85 640 10 960 60C1160 85 1320 40 1440 25V100H0V35Z"
        class="fill-cream"
      />
    </svg>
  </div>
</section>
