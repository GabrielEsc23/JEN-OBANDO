---
import { Image } from "astro:assets";
import focusingImg from "../assets/images/focusing-betal.png";

const tools = [
  {
    number: "01",
    name: "Hakomi",
    subtitle: "Escucha somática",
    imageUrl:
      "https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=800&q=80",
    imageAlt: "Presencia somática y mindfulness corporal",
    description:
      "Atención plena a lo que sientes en el cuerpo para descubrir y transformar con compasión creencias profundas y patrones automáticos grabados en tu sistema nervioso.",
    tag: "Mindfulness somático",
  },
  {
    number: "02",
    name: "Focusing",
    subtitle: "Sensación sentida",
    image: focusingImg,
    imageAlt: "Focusing — Conexión con la sensación sentida corporal",
    description:
      "Aprender a conectar con la sensación física interior sin palabras previas, permitiendo que tu propio cuerpo guíe lo que necesita nombrar y transformar a su propio tiempo.",
    tag: "Sabiduría visceral",
  },
  {
    number: "03",
    name: "Terapia Centrada en la Persona",
    subtitle: "Carl Rogers",
    imageUrl:
      "https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&w=800&q=80",
    imageAlt: "Espacio de escucha empática incondicional",
    description:
      "Acompañamiento basado en la aceptación incondicional y la empatía profunda. Tú eres la persona experta en tu propia vida; yo te ofrezco un espacio sagrado donde reencontrarte.",
    tag: "Aceptación radical",
  },
  {
    number: "04",
    name: "IFS — Partes Internas",
    subtitle: "Sistemas Familiares Internos",
    imageUrl:
      "https://images.unsplash.com/photo-1518241353330-0f7941c2d9b5?auto=format&fit=crop&w=800&q=80",
    imageAlt: "Integración compasiva de partes internas",
    description:
      "Comprender, validar y armonizar las diferentes partes de tu psique (la crítica, la protectora, la herida) desde tu Yo Esencial, devolviéndoles paz y equilibrio.",
    tag: "Autocompasión e integración",
  },
];
---

<section id="herramientas" class="py-24 md:py-32 bg-cream relative overflow-hidden isolate">
  <!-- Patrón repetido celestial sutil (Sol, Luna, Estrellas y Destellos) -->
  <div
    class="absolute inset-0 bg-[url('/patterns/celestial-pattern.svg')] bg-repeat opacity-[0.20] pointer-events-none -z-10 [background-size:180px_180px]"
    aria-hidden="true"
  ></div>

  <!-- Sutiles líneas botánicas de fondo -->
  <div class="absolute top-12 right-0 w-80 h-80 opacity-15 pointer-events-none text-gold -z-10">
    <svg viewBox="0 0 200 200" fill="none" class="w-full h-full stroke-current" stroke-width="0.8">
      <path d="M100 180 C120 130 180 110 180 50 C140 70 120 100 100 180 Z" />
      <path d="M100 180 C80 130 20 110 20 50 C60 70 80 100 100 180 Z" />
      <path d="M100 180 L100 20" stroke-dasharray="2 4" />
    </svg>
  </div>

  <div class="max-w-[1360px] mx-auto px-6 lg:px-12 relative z-10">
    <!-- Encabezado Editorial -->
    <div class="max-w-2xl mx-auto text-center mb-16 md:mb-20">
      <span class="text-xs uppercase tracking-[0.22em] font-sans font-semibold text-earth block mb-3">
        HERRAMIENTAS TERAPÉUTICAS
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-forest font-normal leading-[1.12] mb-5">
        Un acompañamiento profundo y personalizado
      </h2>
      <p class="font-sans text-charcoal/80 text-base md:text-lg leading-relaxed max-w-xl mx-auto">
        Integro diferentes enfoques somáticos y humanistas para acompañarte de manera completa, respetando tu propio ritmo y la sabiduría innata de tu cuerpo.
      </p>
    </div>

    <!-- Grid de 4 Herramientas con siluetas orgánicas tipo Pebble -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-7 items-stretch">
      {tools.map((tool) => (
        <article class="group bg-ivory rounded-[24px] border border-charcoal/8 p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-card hover:border-gold/40 hover:-translate-y-1">
          <div>
            <!-- Contenedor de Imagen con Silueta Orgánica / Pebble -->
            <div class="relative w-full aspect-[4/3] mb-6 overflow-hidden rounded-[38%_62%_55%_45%_/_42%_38%_62%_58%] border border-gold/30 bg-cream shadow-xs transition-transform duration-500 group-hover:scale-[1.03]">
              {tool.image ? (
                <Image
                  src={tool.image}
                  alt={tool.imageAlt}
                  class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                  width={600}
                  height={450}
                  quality={90}
                />
              ) : (
                <img
                  src={tool.imageUrl}
                  alt={tool.imageAlt}
                  class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="absolute inset-0 bg-forest/5 group-hover:bg-transparent transition-colors duration-300"></div>
            </div>

            <!-- Número y Metadato -->
            <div class="flex items-center justify-between mb-3">
              <span class="font-serif text-2xl text-gold font-light tracking-wider">
                {tool.number}
              </span>
              <span class="text-[11px] font-sans font-medium text-earth/90 uppercase tracking-wider bg-cream px-2.5 py-1 rounded-full border border-gold/25">
                {tool.tag}
              </span>
            </div>

            <!-- Título y Subtítulo -->
            <h3 class="font-serif text-xl lg:text-2xl text-forest font-medium leading-snug mb-1">
              {tool.name}
            </h3>
            <p class="font-sans text-xs uppercase tracking-wider text-muted font-medium mb-3.5">
              {tool.subtitle}
            </p>

            <!-- Descripción -->
            <p class="font-sans text-charcoal/80 text-sm leading-relaxed">
              {tool.description}
            </p>
          </div>

          <!-- Sutil detalle botánico inferior -->
          <div class="pt-5 mt-6 border-t border-charcoal/8 flex items-center justify-between">
            <span class="text-xs font-sans text-muted">Acompañamiento somático</span>
            <span class="w-1.5 h-1.5 rounded-full bg-gold/70 group-hover:bg-gold transition-colors"></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
