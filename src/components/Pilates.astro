---
import { Image } from "astro:assets";
import pilatesImg from "../assets/images/pilates0.jpeg";

const pillars = [
  {
    title: "Respiración",
    description: "Reconectar con el ritmo natural del aire para serenar el sistema nervioso.",
    icon: "breath",
  },
  {
    title: "Trabajo de Centro",
    description: "Estabilidad, fuerza orgánica y arraigo desde tu núcleo corporal y emocional.",
    icon: "center",
  },
  {
    title: "Postura & Equilibrio",
    description: "Habitar una postura que libere tensiones y devuelva balance a tu día a día.",
    icon: "balance",
  },
];
---

<section id="pilates" class="py-24 md:py-32 bg-cream text-charcoal relative overflow-hidden isolate">
  <!-- Patrón repetido celestial sutil (Sol, Luna, Estrellas y Destellos) -->
  <div
    class="absolute inset-0 bg-[url('/patterns/celestial-pattern.svg')] bg-repeat opacity-[0.20] pointer-events-none -z-10 [background-size:180px_180px]"
    aria-hidden="true"
  ></div>

  <!-- Acentos orgánicos ambientales -->
  <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-forest/5 blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-gold/10 blur-3xl pointer-events-none -z-10"></div>

  <!-- Sutil detalle botánico de fondo -->
  <div class="absolute top-10 right-0 w-80 h-80 opacity-15 pointer-events-none text-gold -z-10">
    <svg viewBox="0 0 200 200" fill="none" class="w-full h-full stroke-current" stroke-width="0.8">
      <path d="M100 180 C120 130 180 110 180 50 C140 70 120 100 100 180 Z"></path>
      <path d="M100 180 C80 130 20 110 20 50 C60 70 80 100 100 180 Z"></path>
      <path d="M100 180 L100 20" stroke-dasharray="2 4"></path>
    </svg>
  </div>

  <div class="max-w-[1360px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Columna Izquierda: Fotografía de Pilates con Marco Orgánico -->
      <div class="lg:col-span-5 relative flex justify-center reveal-on-scroll" data-animate="animate__fadeInLeft" data-duration="1.2s">
        <div class="relative w-full max-w-md lg:max-w-none group">
          
          <!-- Marco decorativo orgánico de fondo -->
          <div class="absolute -inset-3 bg-ivory rounded-[38%_62%_55%_45%_/_42%_38%_62%_58%] border border-charcoal/8 shadow-card -rotate-2 pointer-events-none -z-10"></div>

          <!-- Contenedor con recorte orgánico protagonista -->
          <div class="relative overflow-hidden rounded-[38%_62%_55%_45%_/_42%_38%_62%_58%] border border-gold/40 shadow-card aspect-[4/5] bg-ivory">
            <Image
              src={pilatesImg}
              alt="Práctica de Pilates con enfoque terapéutico y desarrollo humano — Jen Obando"
              class="w-full h-full object-cover object-[center_bottom] filter saturate-[0.98] transition-transform duration-700 ease-out group-hover:scale-105"
              width={900}
              height={1125}
              quality={90}
            />
            <div class="absolute inset-0 bg-forest/5 mix-blend-multiply pointer-events-none"></div>
          </div>

          <!-- Insignia flotante editorial con acabado orgánico -->
          <div class="absolute -bottom-4 sm:-bottom-6 left-1/2 -translate-x-1/2 sm:translate-x-0 sm:left-6 z-20 bg-ivory/95 backdrop-blur-md px-5 py-3 rounded-2xl border border-charcoal/8 shadow-card flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-gold"></span>
            <div class="text-left">
              <span class="text-[11px] font-sans font-semibold tracking-wider uppercase text-forest block">
                Pilates con un enfoque terapéutico
              </span>
              <span class="text-[10px] font-sans text-earth block">
                Cuerpo, mente y sentir
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Contenido y Descripción Editorial -->
      <div class="lg:col-span-7 space-y-8 text-left">
        <div class="reveal-on-scroll" data-animate="animate__fadeInRight" data-delay="100ms">
          <!-- Eyebrow -->
          <span class="text-xs uppercase tracking-[0.24em] font-sans font-semibold text-earth block mb-3">
            PILATES CON ENFOQUE TERAPÉUTICO
          </span>

          <!-- Título Principal -->
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-forest font-normal leading-[1.14] mb-6">
            Donde el cuerpo y las emociones <br class="hidden sm:inline" />
            <span class="italic text-earth">se encuentran</span>
          </h2>

          <!-- Descripción Principal Solicitada -->
          <p class="font-sans text-charcoal/80 text-base sm:text-lg leading-relaxed max-w-2xl mb-4">
            Uno el Pilates con mi formación como terapeuta en desarrollo humano para crear una práctica donde el cuerpo y las emociones se encuentran. A través de la respiración, el trabajo de centro y la postura, te acompaño a escuchar tu cuerpo, a darle espacio a tus tensiones y emociones, y a encontrar equilibrio. Movimiento y presencia se combinan para que vivas una conexión más profunda entre cuerpo, mente y sentir.
          </p>

          <!-- Bienvenida con tipografía caligráfica / script -->
          <p class="font-script text-4xl sm:text-5xl text-forest mt-4 leading-tight">
            Bienvenida.
          </p>
        </div>

        <!-- Grid de 3 Pilares del Pilates con Enfoque Terapéutico -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          {pillars.map((item, index) => (
            <div
              class="bg-ivory rounded-2xl border border-charcoal/8 p-5 transition-all duration-300 hover:border-gold/40 hover:shadow-card reveal-on-scroll"
              data-animate="animate__fadeInUp"
              data-delay={`${index * 120 + 200}ms`}
            >
              <div class="w-9 h-9 rounded-full bg-cream border border-gold/40 flex items-center justify-center text-earth mb-3.5">
                {item.icon === "breath" && (
                  <svg class="w-4 h-4 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                  </svg>
                )}
                {item.icon === "center" && (
                  <svg class="w-4 h-4 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                    <circle cx="12" cy="12" r="3" />
                    <circle cx="12" cy="12" r="7" stroke-dasharray="2 3" />
                  </svg>
                )}
                {item.icon === "balance" && (
                  <svg class="w-4 h-4 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 9l9-6 9 6M6 14l-3 5h6l-3-5zm12 0l-3 5h6l-3-5z" />
                  </svg>
                )}
              </div>
              <h3 class="font-serif text-lg text-forest font-medium mb-1.5">
                {item.title}
              </h3>
              <p class="font-sans text-xs text-charcoal/70 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>

        <!-- Botón de Acción hacia Contacto -->
        <div class="pt-2 reveal-on-scroll" data-animate="animate__fadeInUp" data-delay="450ms">
          <a
            href="#contacto"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-forest text-ivory font-medium text-xs sm:text-sm uppercase tracking-wider hover:bg-moss hover:shadow-floating transition-all duration-300 shadow-card group"
          >
            <span>Consultar por sesiones de Pilates</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
