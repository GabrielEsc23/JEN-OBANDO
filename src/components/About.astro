---
import { Image } from "astro:assets";
import sobreJenImg from "../assets/images/SOBRE JEN.jpeg";

const qualities = [
  {
    title: "Escucha sin ruido propio",
    description:
      "Un espacio despejado de juicios, expectativas y consejos impuestos, donde cada palabra y silencio tuyo tiene acogida incondicional.",
    icon: "ear",
  },
  {
    title: "Sintonía con lo que sientes",
    description:
      "Conexión somática y empática profunda que sintoniza con tu cuerpo y valida tu experiencia emocional en el momento presente.",
    icon: "heart",
  },
  {
    title: "La pregunta exacta",
    description:
      "Indagaciones sutiles y respetuosas que abren puertas interiores, trayendo claridad a lo que antes permanecía difuso o reprimido.",
    icon: "sparkle",
  },
  {
    title: "Sostener sin prisa por arreglar",
    description:
      "Confianza radical en tu propia capacidad organísmica: no estás rota ni necesitas que te reparen, sino un espacio seguro para regresar a ti.",
    icon: "shield",
  },
];
---

<section id="sobre-mi" class="py-24 md:py-32 bg-cream relative overflow-hidden isolate">
  <!-- Patrón repetido celestial sutil (Sol, Luna, Estrellas y Destellos) -->
  <div
    class="absolute inset-0 bg-[url('/patterns/celestial-pattern.svg')] bg-repeat opacity-[0.20] pointer-events-none -z-10 [background-size:180px_180px]"
    aria-hidden="true"
  ></div>

  <!-- Acentos decorativos de fondo -->
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-forest/5 blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-[1360px] mx-auto px-6 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Columna Izquierda: Retrato con silueta orgánica y firma -->
      <div class="lg:col-span-5 relative flex flex-col items-center">
        <!-- Contenedor Orgánico de la Fotografía -->
        <div class="relative w-full max-w-[420px] aspect-[4/5] rounded-[42%_58%_52%_48%_/_50%_45%_55%_50%] overflow-hidden border border-gold/40 shadow-card bg-ivory">
          <Image
            src={sobreJenImg}
            alt="Jen Obando — Terapeuta Emocional con enfoque Gestalt Integrativo"
            class="w-full h-full object-cover object-top filter saturate-[0.95]"
            width={720}
            height={900}
            quality={92}
          />
          <div class="absolute inset-0 bg-forest/10 mix-blend-multiply"></div>
        </div>

        <!-- Tarjeta Flotante con Firma y Título -->
        <div class="mt-6 sm:-mt-10 sm:relative z-20 bg-ivory/95 backdrop-blur-md border border-charcoal/8 rounded-2xl px-7 py-5 shadow-card max-w-[340px] text-center">
          <p class="font-script text-3xl sm:text-4xl text-forest leading-tight">
            Jen Obando
          </p>
         
          <p class="text-xs font-sans text-muted mt-2 border-t border-charcoal/8 pt-2">
            21 años acompañando la vida y el retorno al cuerpo
          </p>
        </div>
      </div>

      <!-- Columna Derecha: Cita Editorial y Grid 2x2 de Cualidades -->
      <div class="lg:col-span-7 space-y-10">
        <div>
          <span class="text-xs uppercase tracking-[0.22em] font-sans font-semibold text-earth block mb-3">
            SOBRE MÍ
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-[42px] text-forest font-normal leading-[1.18] mb-6">
            «No te acompaño desde lo que leí en un libro... te acompaño desde <span class="italic text-earth">los 21 años</span> en que mi cuerpo aprendió a sostener la vida.»
          </h2>
          <p class="font-sans text-charcoal/80 text-base md:text-lg leading-relaxed max-w-2xl">
            Mi camino terapéutico no nació en un aula abstracta, sino en la experiencia encarnada de cuidar, sentir el límite y reencontrar el pulso de la propia vitalidad. En la Gestalt Integrativa y las terapias somáticas encontré la confirmación de lo que el cuerpo ya sabía: la verdadera transformación ocurre cuando dejamos de pelearnos con lo que sentimos.
          </p>
        </div>

        <!-- Grid 2x2 de Cualidades de Acompañamiento -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
          {qualities.map((item) => (
            <div class="bg-ivory rounded-2xl border border-charcoal/8 p-6 transition-all duration-300 hover:border-gold/40 hover:shadow-card">
              <div class="w-10 h-10 rounded-full bg-cream border border-gold/40 flex items-center justify-center text-earth mb-4">
                {item.icon === "ear" && (
                  <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
                  </svg>
                )}
                {item.icon === "heart" && (
                  <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                )}
                {item.icon === "sparkle" && (
                  <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
                {item.icon === "shield" && (
                  <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </div>
              <h3 class="font-serif text-lg lg:text-xl text-forest font-medium mb-2">
                {item.title}
              </h3>
              <p class="font-sans text-xs sm:text-sm text-charcoal/75 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
