---
const channels = [
  {
    name: "Instagram",
    handle: "@jenobando",
    tagline: "Comunidad · Presencia · Reflexión",
    description:
      "El espacio donde comparto mi voz, micro-prácticas somáticas y reflexiones que acompañan el día a día sin frases vacías ni exigencias de perfección.",
    linkText: "Seguir en Instagram",
    linkUrl: "https://instagram.com/jenobando",
    icon: "instagram",
  },
  {
    name: "WhatsApp Directo",
    handle: "+593 99 999 9999",
    tagline: "Primer contacto · Cercanía · Calidez",
    description:
      "El canal más directo y personal para resolver dudas, consultar disponibilidad de horarios y coordinar tu primera sesión individual o cupo en talleres.",
    linkText: "Escribir por WhatsApp",
    linkUrl: "https://whatsapp.com",
    icon: "whatsapp",
  },
  {
    name: "Web & Newsletter",
    handle: "contacto@jenobando.com",
    tagline: "Artículos · Novedades · Talleres",
    description:
      "Recibe reflexiones mensuales sobre consciencia somática, novedades de nuevos talleres vivenciales y recursos exclusivos para tu proceso.",
    linkText: "Suscribirme / Escribir",
    linkUrl: "mailto:contacto@jenobando.com",
    icon: "mail",
  },
];
---

<section id="contacto" class="py-20 md:py-28 bg-celeste-light/60 border-y border-celeste/25 relative overflow-hidden">
  <!-- Acentos orgánicos ambientales -->
  <div class="absolute -top-16 -left-16 w-80 h-80 rounded-full bg-celeste/20 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-16 -right-16 w-80 h-80 rounded-full bg-crema/80 blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-espresso mb-4">
        Conecta conmigo
      </h2>
      <p class="text-espresso/75 text-base md:text-lg leading-relaxed">
        Cada uno de mis canales cumple una función distinta: desde el primer contacto hasta el acompañamiento continuado, buscando siempre la cercanía y la calidez humana.
      </p>
    </div>

    <!-- Canales de comunicación -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {channels.map((ch) => (
        <div class="bg-crema hover:bg-white border border-sombra/60 hover:border-celeste rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 shadow-xs hover:shadow-md group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-celeste-light/40 border border-celeste/30 flex items-center justify-center text-espresso group-hover:bg-celeste group-hover:text-crema transition-colors mb-6">
              {ch.icon === "instagram" && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="1.8"></rect>
                  <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" stroke-width="1.8"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round"></line>
                </svg>
              )}
              {ch.icon === "whatsapp" && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              )}
              {ch.icon === "mail" && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              )}
            </div>

            <h3 class="text-xl font-bold text-espresso mb-1 group-hover:text-celeste-dark transition-colors">
              {ch.name}
            </h3>
            <p class="text-xs font-semibold text-celeste-dark tracking-wide mb-3">
              {ch.tagline}
            </p>
            <p class="text-xs font-medium text-espresso/60 mb-4">
              {ch.handle}
            </p>

            <p class="text-espresso/75 text-sm leading-relaxed mb-6">
              {ch.description}
            </p>
          </div>

          <div class="pt-6 border-t border-sombra/25">
            <a
              href={ch.linkUrl}
              target={ch.linkUrl.startsWith("http") ? "_blank" : "_self"}
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-espresso hover:text-celeste transition-colors"
            >
              <span>{ch.linkText}</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
