---
const channels = [
  {
    name: "Instagram",
    handle: "@jenobando",
    label: "Comunidad y reflexiones",
    description:
      "Micro-prácticas somáticas, reflexiones sinceras y presencia diaria sin exigencias de perfección.",
    linkText: "Seguir en Instagram",
    linkUrl: "https://instagram.com/jenobando",
    icon: "instagram",
  },
  {
    name: "WhatsApp Directo",
    handle: "+593 99 999 9999",
    label: "Primer contacto y citas",
    description:
      "El canal más cálido y directo para consultar disponibilidad, resolver dudas y coordinar tu proceso en Quito u online.",
    linkText: "Escribir por WhatsApp",
    linkUrl: "https://wa.me/593999999999?text=Hola%20Jen,%20quisiera%20consultar%20sobre%20tus%20sesiones%20terap%C3%A9uticas",
    icon: "whatsapp",
  },
  {
    name: "Web & Correo",
    handle: "contacto@jenobando.com",
    label: "Talleres y novedades",
    description:
      "Recibe escritos mensuales sobre consciencia somática y convocatorias de nuevos grupos vivenciales.",
    linkText: "Escribir un correo",
    linkUrl: "mailto:contacto@jenobando.com",
    icon: "mail",
  },
];
---

<section id="contacto" class="pt-20 md:pt-28 pb-28 md:pb-36 bg-cream text-charcoal relative overflow-hidden isolate">
  <!-- Patrón repetido celestial sutil (Sol, Luna, Estrellas y Destellos) -->
  <div
    class="absolute inset-0 bg-[url('/patterns/celestial-pattern.svg')] bg-repeat opacity-[0.20] pointer-events-none -z-10 [background-size:180px_180px]"
    aria-hidden="true"
  ></div>

  <!-- Acentos orgánicos ambientales -->
  <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-gold/10 blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-forest/5 blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-[1360px] mx-auto px-6 lg:px-12 relative z-10">
    
    <!-- Encabezado Editorial de Contacto -->
    <div class="max-w-2xl mx-auto text-center mb-14 md:mb-18 reveal-on-scroll" data-animate="animate__fadeInUp">
      <span class="text-xs uppercase tracking-[0.24em] font-sans font-semibold text-earth block mb-3">
        PRIMER CONTACTO
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-forest font-normal leading-[1.12] mb-4">
        Conéctate
      </h2>
      <p class="font-sans text-charcoal/80 text-base md:text-lg leading-relaxed max-w-xl mx-auto">
        Elige el canal más cómodo para ti. Te responderé personalmente para coordinar tu proceso en Quito o en modalidad virtual desde cualquier lugar.
      </p>
    </div>

    <!-- Grid de 3 Canales de Comunicación -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {channels.map((ch, index) => (
        <a
          href={ch.linkUrl}
          target={ch.linkUrl.startsWith("http") ? "_blank" : "_self"}
          rel="noopener noreferrer"
          class="group bg-ivory rounded-[24px] border border-charcoal/8 p-8 flex flex-col justify-between shadow-card hover:border-gold/50 hover:shadow-floating hover:-translate-y-1 transition-all duration-300 reveal-on-scroll"
          data-animate="animate__fadeInUp"
          data-delay={`${index * 150 + 100}ms`}
        >
          <div>
            <!-- Icono circular elegante -->
            <div class="w-13 h-13 w-12 h-12 rounded-full bg-cream border border-gold/40 flex items-center justify-center text-forest group-hover:bg-forest group-hover:text-ivory group-hover:border-forest transition-all duration-300 mb-6 shadow-xs">
              {ch.icon === "instagram" && (
                <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-linecap="round"></line>
                </svg>
              )}
              {ch.icon === "whatsapp" && (
                <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              )}
              {ch.icon === "mail" && (
                <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
            </div>

            <!-- Título y metadatos -->
            <span class="text-[11px] font-sans font-semibold uppercase tracking-wider text-earth block mb-1">
              {ch.label}
            </span>
            <h3 class="font-serif text-2xl text-forest font-medium mb-1 group-hover:text-earth transition-colors">
              {ch.name}
            </h3>
            <p class="font-sans text-xs text-muted font-medium mb-4">
              {ch.handle}
            </p>

            <p class="font-sans text-charcoal/75 text-sm leading-relaxed mb-6">
              {ch.description}
            </p>
          </div>

          <!-- Enlace de acción -->
          <div class="pt-5 border-t border-charcoal/8 flex items-center justify-between">
            <span class="text-xs font-sans font-medium uppercase tracking-wider text-forest group-hover:text-earth transition-colors">
              {ch.linkText}
            </span>
            <span class="text-forest group-hover:text-earth group-hover:translate-x-1 transition-all duration-200">
              →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Nota de Confidencialidad -->
    <div class="mt-14 text-center reveal-on-scroll" data-animate="animate__fadeIn" data-delay="350ms">
      <p class="text-xs font-sans text-muted">
        ✦ Todo contacto se maneja con estricta confidencialidad y calidez humana · Quito, Ecuador.
      </p>
    </div>

  </div>

  <!-- Borde inferior ondulado hacia el footer oscuro -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none translate-y-[1px]">
    <svg
      class="relative block w-full h-8 sm:h-12 md:h-16"
      viewBox="0 0 1440 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        d="M0 45C300 75 600 20 900 55C1140 80 1320 40 1440 30V100H0V45Z"
        class="fill-[#12221a]"
      />
    </svg>
  </div>
</section>
