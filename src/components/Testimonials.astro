---
const testimonials = [
  {
    quote:
      "Llegué creyendo que solo necesitaba hablar de lo que me pasaba. Jen me mostró que el cuerpo ya lo sabía todo. Fue la primera vez que me sentí realmente escuchada — sin que nadie me intentara arreglar.",
    author: "Participante de Taller Vivencial",
    location: "El Porvenir, Guayaquil",
    tag: "Taller Grupal",
  },
  {
    quote:
      "Más de dos décadas cuidando a los demás y nunca me había preguntado cómo estaba yo. En las sesiones con Jen aprendí que elegirme no es abandonar a nadie; es volver a casa.",
    author: "Consultante de Terapia Individual",
    location: "Modalidad Virtual",
    tag: "Acompañamiento 1 a 1",
  },
];
---

<section id="testimonios" class="py-20 md:py-28 bg-coral-light/50 border-y border-coral/20 relative overflow-hidden">
  <!-- Acentos orgánicos ambientales -->
  <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-coral/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-celeste-light/40 blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-espresso mb-4">
        Lo que dicen quienes la vivieron
      </h2>
      <p class="text-espresso/75 text-base md:text-lg leading-relaxed">
        La resonancia viva de consultantes y asistentes que han encontrado en este camino un espacio seguro de reconciliación y retorno a sí mismas.
      </p>
    </div>

    <!-- Grid de Testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonials.map((item) => (
        <div class="bg-crema p-8 md:p-10 rounded-2xl border border-sombra/60 shadow-xs hover:shadow-md flex flex-col justify-between relative group hover:border-coral/60 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-[11px] font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-coral-light/70 text-coral-dark border border-coral/20">
                {item.tag}
              </span>
              <span class="text-3xl font-serif text-coral/40 select-none">“</span>
            </div>

            <blockquote class="text-base md:text-lg font-normal text-espresso leading-relaxed italic mb-8">
              “{item.quote}”
            </blockquote>
          </div>

          <div class="pt-6 border-t border-sombra/25 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <!-- Espacio para avatar sutil / fotografía del consultante -->
              <div class="w-10 h-10 rounded-full bg-celeste-light/30 border border-dashed border-celeste/40 flex items-center justify-center text-celeste-dark flex-shrink-0 text-xs font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>

              <div>
                <p class="font-bold text-espresso text-sm md:text-base">
                  {item.author}
                </p>
                <p class="text-xs text-espresso/60">
                  {item.location}
                </p>
              </div>
            </div>

            <div class="w-8 h-8 rounded-full bg-ambar-light flex items-center justify-center text-ambar-dark">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
