---
const currentYear = 2026;
---

<footer class="bg-[#F1F6FA] border-t border-sombra/40 py-12 md:py-16 text-espresso/70 text-xs">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8">
    
    <!-- Branding & Info -->
    <div class="text-center md:text-left space-y-1">
      <p class="text-sm font-bold text-espresso tracking-tight">
        JEN OBANDO
      </p>
      <p class="text-xs text-espresso/60">
        Terapeuta Emocional · Gestalt Integrativo · Consciencia Somática
      </p>
      <p class="text-[11px] text-espresso/50 pt-1">
        Guayaquil, Ecuador
      </p>
    </div>

    <!-- Quick Links -->
    <nav class="flex flex-wrap justify-center gap-6 text-xs text-espresso/75">
      <a href="#sobre-jen" class="hover:text-celeste transition-colors">Mi enfoque</a>
      <a href="#pilares" class="hover:text-celeste transition-colors">Pilares</a>
      <a href="#herramientas" class="hover:text-celeste transition-colors">Herramientas</a>
      <a href="#servicios" class="hover:text-celeste transition-colors">Servicios</a>
      <a href="#contacto" class="hover:text-celeste transition-colors">Contacto</a>
    </nav>

    <!-- Back to top & copyright -->
    <div class="flex flex-col items-center md:items-end gap-3">
      <a
        href="#"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-crema hover:bg-celeste-light/60 border border-sombra/50 text-espresso hover:text-celeste-dark text-[11px] font-medium transition-colors"
      >
        <span>Volver arriba</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </a>
      <p class="text-[11px] text-espresso/50 text-center md:text-right">
        © {currentYear} Jen Obando · Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
