---
import { Image } from "astro:assets";
import therapySpaceImg from "../assets/images/FullSizeRender.jpeg";
---

<section id="gestalt" class="py-20 md:py-28 bg-cream relative overflow-hidden isolate">
  <!-- Patrón repetido celestial sutil (Sol, Luna, Estrellas y Destellos) -->
  <div
    class="absolute inset-0 bg-[url('/patterns/celestial-pattern.svg')] bg-repeat opacity-[0.20] pointer-events-none -z-10 [background-size:180px_180px]"
    aria-hidden="true"
  ></div>

  <!-- Detalle botánico decorativo lineal sutil en la esquina superior derecha -->
  <div class="absolute -top-10 -right-10 w-64 h-64 opacity-20 pointer-events-none text-gold -z-10">
    <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.2" class="w-full h-full">
      <path d="M100,10 C120,50 160,80 190,100 C150,110 120,150 100,190 C80,150 50,110 10,100 C50,80 80,50 100,10 Z"></path>
      <path d="M100,10 C100,100 100,100 100,190"></path>
      <path d="M100,60 C120,70 140,85 150,100"></path>
      <path d="M100,80 C80,90 60,105 50,120"></path>
      <path d="M100,120 C120,130 140,145 150,160"></path>
      <path d="M100,140 C80,150 60,165 50,180"></path>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Columna izquierda: Imagen con silueta orgánica curva -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="relative w-full max-w-md lg:max-w-lg">
          <!-- Fondo decorativo tipo sombra orgánica -->
          <div class="absolute -inset-2 bg-ivory rounded-[45%_55%_60%_40%_/_50%_45%_55%_50%] border border-charcoal/8 shadow-card -z-10 transform rotate-2 pointer-events-none"></div>

          <!-- Contenedor con recorte orgánico tipo hoja/gota -->
          <div class="relative overflow-hidden rounded-[45%_55%_60%_40%_/_50%_45%_55%_50%] border border-charcoal/10 shadow-floating aspect-[4/3] sm:aspect-[16/11] bg-ivory">
            <Image
              src={therapySpaceImg}
              alt="Espacio terapéutico acogedor de Jen Obando — Consciencia y calma"
              class="w-full h-full object-cover object-center filter saturate-[0.95]"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Columna derecha: Explicación y botón -->
      <div class="lg:col-span-6 space-y-6 text-left">
        

        <!-- Titular H2 Editorial -->
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[46px] leading-[1.12] text-charcoal font-normal">
          ¿Qué es la Terapia <br class="hidden sm:inline" />
          Gestalt Integrativa?
        </h2>

        <!-- Párrafo explicativo fiel al mockup -->
        <p class="text-base sm:text-lg text-charcoal/80 leading-relaxed font-normal max-w-xl">
          Es una forma de acompañamiento que no busca "arreglarte" como si estuvieras rota, sino devolverte a la totalidad de lo que eres. Trabajamos en el aquí y ahora, escuchando lo que tu cuerpo expresa (tensiones, nudos, cansancio) para alinear lo que piensas, sientes y haces mediante un espacio seguro y sin juicios.
        </p>

        
        
      </div>

    </div>
  </div>

  <!-- Divisor inferior con borde ondulado hacia la sección oscura de Pilares -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none translate-y-[1px]">
    <svg
      class="relative block w-full h-8 sm:h-12 md:h-16 lg:h-20"
      viewBox="0 0 1440 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        d="M0 45C240 85 480 15 720 50C960 85 1200 20 1440 60V100H0V45Z"
        class="fill-forest"
      />
    </svg>
  </div>
</section>
