---
import { Image } from "astro:assets";
import bannerHero from "../assets/images/BANNER HERO.jpeg";
---

<section class="relative min-h-[680px] lg:min-h-[760px] pt-8 pb-16 md:py-20 bg-cream overflow-hidden flex items-center isolate">
  <!-- Subtle warm natural ambient background glow -->
  <div class="absolute top-1/3 right-10 w-[500px] h-[500px] rounded-full bg-gold/15 blur-3xl -z-10 pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 rounded-full bg-earth/10 blur-3xl -z-10 pointer-events-none"></div>

  <!-- Patrón repetido celestial sutil (Sol, Luna, Estrellas y Destellos) -->
  <div
    class="absolute inset-0 bg-[url('/patterns/celestial-pattern.svg')] bg-repeat opacity-[0.22] pointer-events-none -z-10 [background-size:180px_180px]"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Columna de Titular y CTA (en móvil va después de la foto) -->
      <div class="order-2 lg:order-1 lg:col-span-6 space-y-7 text-left z-10">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 animate__animated animate__fadeInDown [animation-duration:0.9s]">
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.22em] uppercase text-earth">
            JEN OBANDO | TERAPEUTA EMOCIONAL
          </span>
        </div>

        <!-- H1 Hero Editorial -->
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-[64px] leading-[1.08] text-charcoal font-normal animate__animated animate__fadeInUp [animation-duration:1.1s]">
          El secreto no está <br />
          en entenderlo todo... <br />
          <span class="italic font-normal">está en volver a sentir.</span>
        </h1>

        <!-- Subtítulo / Descripción -->
        <p class="text-base sm:text-lg text-charcoal/80 leading-relaxed font-normal max-w-lg animate__animated animate__fadeInUp [animation-duration:1.1s] [animation-delay:0.2s]">
          Acompaño a mujeres a vivir transformaciones reales desde el cuerpo, las emociones y la experiencia vivida. Sin teorías frías de libro: desde el camino recorrido, con los pies en la tierra.
        </p>

        <!-- CTA Principal -->
        <div class="pt-2 animate__animated animate__fadeInUp [animation-duration:1.1s] [animation-delay:0.35s]">
          <a
            href="#contacto"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-forest text-ivory hover:bg-moss hover:shadow-floating transition-all duration-300 font-medium text-sm tracking-wide group shadow-card"
          >
            <span>Agendar una consulta</span>
            <span class="text-base transition-transform group-hover:translate-x-1.5 duration-200">→</span>
          </a>
        </div>
      </div>

      <!-- Columna de Fotografía (en móvil va primero) -->
      <div class="order-1 lg:order-2 lg:col-span-6 relative flex justify-center lg:justify-end animate__animated animate__fadeIn [animation-duration:1.4s] [animation-delay:0.2s]">
        
        <!-- Contenedor de la fotografía con recorte orgánico y atmósfera cálida -->
        <div class="relative w-full max-w-md lg:max-w-lg">
          <!-- Marco sutil orgánico de fondo -->
          <div class="absolute -inset-2 sm:-inset-3 bg-ivory/80 rounded-[38%_62%_55%_45%_/_42%_38%_62%_58%] border border-charcoal/8 shadow-card -z-10 transform -rotate-1 pointer-events-none"></div>

          <!-- Imagen con recorte orgánico protagonista -->
          <div class="relative overflow-hidden rounded-[38%_62%_55%_45%_/_42%_38%_62%_58%] border border-charcoal/10 shadow-floating aspect-[4/5] bg-ivory">
            <Image
              src={bannerHero}
              alt="Jen Obando — El secreto no está en entenderlo todo, está en volver a sentir"
              class="w-full h-full object-cover object-center filter saturate-[0.98] contrast-[1.02]"
              loading="eager"
            />
            <!-- Gradiente cálido sutil de luz solar -->
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/20 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>

        <!-- Indicador vertical flotante en el lateral derecho: Consciencia / Presencia / Coherencia -->
        <div class="hidden xl:flex flex-col items-center gap-4 absolute -right-8 top-1/4 text-muted/80 text-[11px] tracking-[0.2em] uppercase font-sans select-none pointer-events-none animate__animated animate__fadeIn [animation-duration:1.2s] [animation-delay:0.5s]">
          <span class="[writing-mode:vertical-rl] rotate-180">Consciencia</span>
          <span class="w-1 h-1 rounded-full bg-gold"></span>
          <span class="[writing-mode:vertical-rl] rotate-180">Presencia</span>
          <span class="w-1 h-1 rounded-full bg-gold"></span>
          <span class="[writing-mode:vertical-rl] rotate-180">Coherencia</span>
        </div>

        <!-- Indicador inferior: Desliza para explorar -->
       

      </div>

    </div>
  </div>
</section>
