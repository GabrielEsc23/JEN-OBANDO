---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jen Obando | Terapeuta Emocional · Gestalt Integrativo",
  description = "El secreto no está en entenderlo todo... está en volver a sentir. Acompañamiento terapéutico con enfoque Gestalt Integrativo: Consciencia, Presencia y Coherencia en Quito, Ecuador.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Cormorant Garamond & DM Sans & Alex Brush -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Animate.css Library (https://animate.style/) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />
  </head>
  <body class="bg-cream text-charcoal font-sans antialiased selection:bg-gold/30 selection:text-forest min-h-screen flex flex-col">
    <slot />

    <!-- Scroll Reveal Controller for Animate.css -->
    <script is:inline>
      (function () {
        const initScrollAnimations = () => {
          const elements = document.querySelectorAll(".reveal-on-scroll");
          if (!elements.length) return;

          // If browser doesn't support IntersectionObserver or user prefers reduced motion
          if (
            !("IntersectionObserver" in window) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            elements.forEach((el) => {
              el.classList.remove("reveal-on-scroll");
              el.style.opacity = "1";
              el.style.visibility = "visible";
            });
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const el = entry.target;
                  const anim = el.getAttribute("data-animate") || "animate__fadeInUp";
                  const delay = el.getAttribute("data-delay");
                  const duration = el.getAttribute("data-duration");

                  if (delay) el.style.animationDelay = delay;
                  if (duration) el.style.animationDuration = duration;

                  el.classList.add("animate__animated", anim);
                  observer.unobserve(el);
                }
              });
            },
            {
              threshold: 0.12,
              rootMargin: "0px 0px -40px 0px",
            }
          );

          elements.forEach((el) => observer.observe(el));
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollAnimations);
        } else {
          initScrollAnimations();
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Animate.css serene defaults */
    --animate-duration: 1.1s;
    --animate-delay: 0.2s;

    /* Colors */
    --color-cream: #F5F0E7;
    --color-ivory: #FBF8F2;
    --color-forest: #172A21;
    --color-moss: #263B2D;
    --color-gold: #B89A6A;
    --color-earth: #956B4E;
    --color-charcoal: #292923;
    --color-muted: #77746C;
    --color-white: #FFFFFF;

    /* Typography */
    --font-heading: "Cormorant Garamond", Georgia, serif;
    --font-body: "DM Sans", Arial, sans-serif;
    --font-signature: "Alex Brush", cursive;

    /* Layout */
    --container-max: 1440px;
    --reading-max: 720px;
    --gutter: clamp(1.25rem, 5.5vw, 5.5rem);
    --section-space: clamp(4rem, 8vw, 8rem);

    /* Borders */
    --border-subtle: 1px solid rgba(41, 41, 35, 0.08);
    --border-gold: 1px solid rgba(184, 154, 106, 0.45);

    /* Radius */
    --radius-card: 1.25rem;
    --radius-image: 1.5rem;
    --radius-pill: 9999px;

    /* Shadows */
    --shadow-card: 0 12px 32px rgba(31, 38, 30, 0.06);
    --shadow-floating: 0 18px 50px rgba(20, 30, 23, 0.12);

    /* Motion */
    --ease-editorial: cubic-bezier(0.22, 1, 0.36, 1);
    --duration-fast: 200ms;
    --duration-reveal: 600ms;
  }

  body {
    background-color: var(--color-cream);
    color: var(--color-charcoal);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, h4, .font-serif {
    font-family: var(--font-heading);
  }

  .font-signature {
    font-family: var(--font-signature);
  }

  /* Custom subtle scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #F5F0E7;
  }
  ::-webkit-scrollbar-thumb {
    background: #CEB489;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #B89A6A;
  }

  /* Organic blob classes */
  .organic-shape-1 {
    border-radius: 38% 62% 55% 45% / 42% 38% 62% 58%;
  }

  .organic-shape-2 {
    border-radius: 63% 37% 54% 46% / 44% 56% 44% 56%;
  }

  .organic-shape-3 {
    border-radius: 45% 55% 60% 40% / 50% 45% 55% 50%;
  }

  .organic-arch-bottom {
    border-radius: 18px 18px 45% 45% / 18px 18px 18px 18px;
  }

  /* Animate.css on-scroll reveal styling */
  .reveal-on-scroll {
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }

  .reveal-on-scroll.animate__animated {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1 !important;
      visibility: visible !important;
      animation: none !important;
    }
  }
</style>
